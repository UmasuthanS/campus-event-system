# Local development only. Never commit real connection credentials.
MONGODB_URI='mongodb://127.0.0.1:27017/campus_events?serverSelectionTimeoutMS=2000&connectTimeoutMS=2000'
SERVER_PORT=8080
# dev enables index creation and idempotent club seeding; MongoDB must be running.
SPRING_PROFILES_ACTIVE=dev
MONGODB_AUTO_INDEX_CREATION=true
SEED_CLUBS=true

# JWT_SECRET is loaded automatically from config/local.properties.
# Alternatively export JWT_SECRET in your shell; do not export an empty value.
JWT_TTL_SECONDS=900
JWT_ISSUER=campus-event-system

# Optional, development-only first Super Admin. Disabled by default.
# Fill all values using the registration validation rules, enable for one startup,
# then disable and remove these credentials from your local environment.
BOOTSTRAP_SUPER_ADMIN=false
BOOTSTRAP_SUPER_ADMIN_NAME=
BOOTSTRAP_SUPER_ADMIN_REGISTRATION_NUMBER=
BOOTSTRAP_SUPER_ADMIN_EMAIL=
BOOTSTRAP_SUPER_ADMIN_PASSWORD=
